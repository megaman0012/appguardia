# Binarios grandes que exceden el límite de GitHub (100 MB por archivo)
*.apk

# Dependencias y builds (reforzado; ya están ignorados en los sub-proyectos)
node_modules/
vendor/
**/build/

# ⚠️ `vendor/` de arriba caza CUALQUIER carpeta con ese nombre a cualquier
# profundidad, y eso incluye `resources/views/vendor` -- las vistas de paquetes
# que sobrescribimos, que son codigo nuestro y no dependencias. Ya se colo una
# vez: el override de la marca de Filament quedo sin versionar y en un clon
# nuevo el panel volvia al texto sin logo, sin que nada avisara.
#
# La negacion tiene que ser de la CARPETA: git no puede re-incluir un archivo
# si su directorio padre esta excluido.
!totalsecureapp/backend/resources/views/vendor/

# Credenciales sensibles - no versionar
Credencial*todos.txt

# Volcados de base de datos. Traen datos reales de personas -- cedulas, correos,
# hashes de contrasena, GPS -- y este repo esta en GitHub. Un `git add -A`
# distraido los publica y sacarlos del historial despues es reescribirlo.
*.sql
!totalsecureapp/backend/docker/postgres/init/*.sql
*.dump
*.sql.gz

# Subidas y respaldos grandes. `images.zip.download` (la carpeta de fotos de v1,
# ~42.000 archivos) entro por un `git add -A` mientras se estaba subiendo y
# quedo en el commit 0682009, ya empujado a GitHub. GitHub rechaza archivos de
# mas de 100 MB, asi que el push siguiente fallo con la subida ya completa.
*.zip
*.download
*.tar
*.tar.gz
*.tgz
*.rar
# Datos de v1 fuera del directorio web (ver ANALISIS-MIGRACION-V1.md).
/datos-v1/

# Entregables y claves de firma. `*.apk` cubria el APK pero NO el keystore que
# se guarda al lado para poder bajar las dos cosas juntas: sin esta linea, un
# `git add -A` publicaba la clave de firma en GitHub. Un keystore filtrado
# permite firmar actualizaciones haciendose pasar por la app, y no se revoca.
/apk/
*.jks
*.keystore
!totalsecureapp/android/app/debug.keystore

# Paquete de contexto generado por repomix
repomix-output.xml
