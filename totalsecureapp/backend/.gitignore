/node_modules
/public/hot
/public/storage

# Contenido subido por la app (fotos de accesos, biometria, rondas): ~1 GB.
# Las dos imagenes de la pantalla de login si estan forzadas al repositorio.
/public/images

# El panel legacy (/acceso/login) carga jQuery y AdminLTE desde aca. La carpeta
# completa pesa 127 MB, asi que se ignora, PERO los 41 archivos que las vistas
# referencian estan forzados al repositorio con `git add -f` (7 MB). Sin ellos un
# clon nuevo se queda sin jQuery y el formulario de login —que envia por AJAX— no
# funciona: nadie puede entrar al sistema.
/public/AdminLTE320
/storage/*.key
/vendor
.env
.env.backup
.phpunit.result.cache
# PHPUnit 10 usa un directorio, no un archivo
.phpunit.cache
docker-compose.override.yml
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/.idea
/.vscode
composer.phar
/storage/logs/*.log
*.bak
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*

# Salida del generador de marca: se rehace con scripts/generar-marca.php
/scripts/marca/salida

# Recursos que publica Filament con `php artisan filament:assets`. Se
# regeneran en cada despliegue y cambian con cada version de la libreria: 11
# archivos y ~1 MB que no aportan nada al historial. **Hay que correr ese
# comando al desplegar**, o el panel sale sin estilos ni tipografia.
/public/css/filament
/public/js/filament
/public/fonts
