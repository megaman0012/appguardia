# ─────────────────────────────────────────────────────────────────────────────
# Total Secure App — plantilla de PRODUCCION (dominio totalsecureapp.com)
#
# Copiar a .env EN EL SERVIDOR REAL y completar los valores marcados.
# NO reemplaza el .env local: ese sigue con APP_ENV=local y HTTP.
#
# Diferencias clave contra el local, y por que:
#   APP_ENV=production   -> desactiva helpers de desarrollo
#   APP_DEBUG=false      -> sin esto, cualquier error muestra el stack trace con
#                           rutas y credenciales al visitante. Es el cambio mas
#                           importante de este archivo.
#   APP_URL con https    -> Laravel genera enlaces absolutos con este valor
#                           (correos de cambio de clave, assets de Filament)
#   LOG_LEVEL=warning    -> 'debug' en produccion llena el disco
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Total Secure App"
APP_ENV=production
APP_KEY=                       # generar en el servidor: php artisan key:generate
APP_DEBUG=false
APP_URL=https://totalsecureapp.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Base de datos ──
# DB_HOST=db dentro de la red docker. Desde el host seria 127.0.0.1 y el puerto
# publicado (5434 en el compose actual).
DB_CONNECTION=postgres
DB_HOST=db
DB_PORT=5432
DB_DATABASE=coredt360
DB_USERNAME=totalsecure
DB_PASSWORD=                   # contraseña NUEVA y distinta a la de desarrollo

# ── Panel (Filament / Livewire) ──
# Livewire arma la URL de su JS como <valor>/vendor/livewire/livewire.js.
# DEJAR VACIO: produce la ruta relativa /vendor/livewire/livewire.js, que funciona
# en cualquier host y esquema.
# No poner el dominio con /admin: daria /admin/vendor/livewire/livewire.js -> 404,
# y sin ese JS el panel se ve pero no responde (columnas, filtros, modales, nada).
FILAMENT_LIVEWIRE=
FILAMENT_DARK=true

BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local

# ── Cache y colas ──
# 'file' y 'sync' funcionan con UN solo servidor. Si en algun momento hay mas de
# una instancia, pasar a redis: el cache del dashboard no se comparte entre
# procesos y su invalidacion por evento solo aplicaria a la instancia que
# escribio. Ver la seccion Performance de AGENTS.md.
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookies solo por HTTPS. Requiere que el SSL este funcionando: con
# SESSION_SECURE_COOKIE=true sobre HTTP no se puede iniciar sesion en el panel.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Sanctum: dominios que pueden usar autenticacion por cookie (el panel web).
# La app movil usa bearer token y no depende de esta lista.
SANCTUM_STATEFUL_DOMAINS=totalsecureapp.com,www.totalsecureapp.com

# Nginx va delante, asi que Laravel debe confiar en las cabeceras X-Forwarded-*
# para detectar https. Sin esto genera URLs http:// detras del proxy.
TRUSTED_PROXIES=*

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo (cambio de contraseña) ──
MAIL_MAILER=smtp
MAIL_HOST=                     # servidor SMTP real
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@totalsecureapp.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Notificaciones push ──
# Debe coincidir con PUSH_ENV del backend y con el entorno del APK.
PUSH_ENV=prod

# ── Parametro de acceso de la app movil ──
# Lo devuelve POST /api/login como usu_acc.
ACCESS_PARAM_VALUE=
