<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
  </testsuites>
  <php>
    <server name="APP_ENV" value="testing"/>
    <server name="BCRYPT_ROUNDS" value="4"/>
    <server name="CACHE_DRIVER" value="array"/>
    <server name="DB_DATABASE" value="coredt360_testing"/>
    <server name="MAIL_MAILER" value="array"/>
    <server name="QUEUE_CONNECTION" value="sync"/>
    <server name="SESSION_DRIVER" value="array"/>
    <server name="TELESCOPE_ENABLED" value="false"/>
    <!-- Se declara COMO TEXTO, igual que en un .env de verdad. Faltaba, y por
         eso `env('TOKEN_EXPIRE_IN')` devolvia null en las pruebas: PHP convierte
         null a 0 sin chistar para un parametro int|float, asi que el login de la
         API pasaba los tests mientras en produccion respondia 500 con Carbon 3.
         Un entorno de pruebas que no se parece al de produccion no prueba
         produccion. -->
    <server name="TOKEN_EXPIRE_IN" value="3600"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
